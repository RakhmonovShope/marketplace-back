# ============================================================================
# marketplace-backend — muhit o'zgaruvchilari namunasi
#
#   cp .env.example .env
#
# Barcha kalitlar src/common/env.validation.schema.ts da tekshiriladi (Joi).
# `pnpm env:check` — schema va bu fayl mosligini tekshiradi (CI'da ham).
# Bo'sh qoldirilgan qiymat = default (schema'da ko'rsatilgan).
# ============================================================================

# ----- Ilova ---------------------------------------------------------------
NODE_ENV=development            # development | production | test
PORT=3000
APP_NAME=Marketplace            # email'larda ko'rinadigan nom
APP_BASE_URL=http://localhost:3000   # email'dagi havolalar uchun FRONTEND manzili
TRUST_PROXY=false               # nginx/LB ortida: 1 (bitta proxy) | loopback | CIDR
CORS_ORIGINS=                   # vergul bilan: http://localhost:5173,https://admin.example.uz
                                # bo'sh: dev — hammaga ruxsat, prod — hech kimga

# ----- Ma'lumotlar bazasi ---------------------------------------------------
DATABASE_URL=postgresql://app:app@localhost:5432/marketplace?schema=public

# ----- Auth -----------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string          # kamida 16 belgi
JWT_SESSION_EXPIRATION=15m      # access token; BIRLIK MAJBURIY (15m, 1h, 1d)
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=12                # parol hash kuchi (10–15)
EMAIL_VERIFICATION_TTL=1d
PASSWORD_RESET_TTL=1h

# ----- Redis (cache, BullMQ navbatlar, throttler) ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- Logging va monitoring ------------------------------------------------
LOG_LEVEL=                      # fatal|error|warn|info|debug|trace (bo'sh: dev debug, prod info)
LOG_PRETTY=                     # true/false (bo'sh: dev true, prod false → JSON)
APP_ENV=                        # staging | production (Sentry environment; bo'sh = NODE_ENV)
SENTRY_DSN=                     # bo'sh = Sentry o'chiq
SENTRY_RELEASE=                 # masalan git SHA (CI beradi)
SENTRY_TRACES_SAMPLE_RATE=0     # 0..1, performance tracing ulushi
HEALTH_HEAP_LIMIT_MB=1024       # /health/ready: heap chegarasi

# ----- Rate limiting (IP bo'yicha umumiy limit) ------------------------------
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# ----- Pagination -----------------------------------------------------------
PAGE_SIZE=20

# ----- Rasm processing ------------------------------------------------------
IMAGE_CONCURRENCY=              # bo'sh = CPU yadrolari soni

# ----- S3 (hozircha faqat audio upload) -------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=

# ----- Email ----------------------------------------------------------------
MAIL_TRANSPORT=console          # console (dev: xat logga chiqadi) | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Marketplace <no-reply@marketplace.local>

# ----- Swagger (/api) -------------------------------------------------------
SWAGGER_ENABLED=true            # production'da default false; true bo'lsa USER/PASS majburiy
SWAGGER_USER=
SWAGGER_PASS=

# ----- Seed (pnpm seed) — super-admin foydalanuvchi -------------------------
SEED_ADMIN_PHONE=998900000000   # 998XXXXXXXXX
SEED_ADMIN_PASSWORD=            # yangi yaratishda majburiy (kamida 8 belgi)
SEED_ADMIN_EMAIL=
SEED_ADMIN_FIRST_NAME=
SEED_ADMIN_LAST_NAME=
